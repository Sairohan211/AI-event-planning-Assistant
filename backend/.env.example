PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_public_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://127.0.0.1:5173

# Additional keys required for the Node/Express backend connection and authentication
JWT_SECRET=
GEMINI_MODEL=gemini-1.5-flash
# Direct Supabase PostgreSQL connection string. (If left blank, local SQLite fallback is used)
DATABASE_URL=
